class Solution {
public:
    int tsp(vector<vector<int>>& cost) {
        int n = cost.size();

        int totalMasks = 1 << n;

        vector<vector<int>> dp(
            totalMasks,
            vector<int>(n, INT_MAX)
        );

        // Start from city 0
        dp[1][0] = 0;

        for (int mask = 1; mask < totalMasks; mask++) {

            for (int u = 0; u < n; u++) {

                // u must be visited
                if (!(mask & (1 << u)))
                    continue;

                if (dp[mask][u] == INT_MAX)
                    continue;

                // Try visiting city v
                for (int v = 0; v < n; v++) {

                    // Already visited
                    if (mask & (1 << v))
                        continue;

                    int newMask = mask | (1 << v);

                    dp[newMask][v] = min(
                        dp[newMask][v],
                        dp[mask][u] + cost[u][v]
                    );
                }
            }
        }

        // All cities visited
        int fullMask = (1 << n) - 1;

        int ans = INT_MAX;

        // Return to city 0
        for (int i = 1; i < n; i++) {
            ans = min(
                ans,
                dp[fullMask][i] + cost[i][0]
            );
        }

        return ans;
    }
};
