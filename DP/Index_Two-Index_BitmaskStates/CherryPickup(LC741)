class Solution {
public:
    int cherryPickup(vector<vector<int>>& grid) {
        int n = grid.size();

        vector<vector<vector<int>>> dp(
            2 * n - 1,
            vector<vector<int>>(n, vector<int>(n, -1))
        );

        dp[0][0][0] = grid[0][0];

        for (int k = 1; k < 2 * n - 1; k++) {
            for (int r1 = 0; r1 < n; r1++) {
                for (int r2 = 0; r2 < n; r2++) {

                    int c1 = k - r1;
                    int c2 = k - r2;

                    if (c1 < 0 || c1 >= n ||
                        c2 < 0 || c2 >= n)
                        continue;

                    if (grid[r1][c1] == -1 ||
                        grid[r2][c2] == -1)
                        continue;

                    int best = -1;

                    // Both move down
                    if (r1 > 0 && r2 > 0)
                        best = max(best, dp[k-1][r1-1][r2-1]);

                    // Person 1 down, person 2 right
                    if (r1 > 0 && c2 > 0)
                        best = max(best, dp[k-1][r1-1][r2]);

                    // Person 1 right, person 2 down
                    if (c1 > 0 && r2 > 0)
                        best = max(best, dp[k-1][r1][r2-1]);

                    // Both move right
                    if (c1 > 0 && c2 > 0)
                        best = max(best, dp[k-1][r1][r2]);

                    if (best == -1)
                        continue;

                    int cherries = grid[r1][c1];

                    if (r1 != r2)
                        cherries += grid[r2][c2];

                    dp[k][r1][r2] = best + cherries;
                }
            }
        }

        return max(0, dp[2 * n - 2][n - 1][n - 1]);
    }
};
