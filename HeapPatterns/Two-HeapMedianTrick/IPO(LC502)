#include <vector>
#include <queue>
#include <algorithm>

class Solution {
public:
    int findMaximizedCapital(int k, int w, std::vector<int>& profits, std::vector<int>& capital) {
        int n = profits.size();
        
        // Pair up each project's capital requirement with its profit
        std::vector<std::pair<int, int>> projects(n);
        for (int i = 0; i < n; ++i) {
            projects[i] = {capital[i], profits[i]};
        }

        // Sort projects in ascending order by capital requirement
        std::sort(projects.begin(), projects.end());

        // Max-heap to store profits of all projects we can currently afford
        std::priority_queue<int> maxProfitHeap;

        int projectIdx = 0;

        // Pick up to k projects
        for (int i = 0; i < k; ++i) {
            // Push all projects we can afford with current capital 'w' into the max-heap
            while (projectIdx < n && projects[projectIdx].first <= w) {
                maxProfitHeap.push(projects[projectIdx].second);
                projectIdx++;
            }

            // If no projects can be afforded, we cannot proceed further
            if (maxProfitHeap.empty()) {
                break;
            }

            // Always choose the project with the highest profit
            w += maxProfitHeap.top();
            maxProfitHeap.pop();
        }

        return w;
    }
};
