#include <unordered_map>
#include <stack>

class FreqStack {
private:
    std::unordered_map<int, int> freq;
    std::unordered_map<int, std::stack<int>> group;
    int maxFreq = 0;

public:
    FreqStack() {}
    
    void push(int val) {
        int f = ++freq[val];
        if (f > maxFreq) {
            maxFreq = f;
        }
        group[f].push(val);
    }
    
    int pop() {
        int val = group[maxFreq].top();
        group[maxFreq].pop();
        freq[val]--;
        
        if (group[maxFreq].empty()) {
            maxFreq--;
        }
        
        return val;
    }
};
