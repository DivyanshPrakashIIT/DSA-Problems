class Solution {
public:
    int countNegatives(vector<vector<int>>& grid) {

        int count = 0;

        for (int i = 0; i < grid.size(); i++) {

            int left = 0;
            int right = grid[i].size();

            while (left < right) {

                int mid = left + (right - left) / 2;

                if (grid[i][mid] < 0)
                    right = mid;
                else
                    left = mid + 1;
            }

            count += grid[i].size() - left;
        }

        return count;
    }
};
