class Solution {
public:
    // Helper function: check agar speed 'k' valid hai
    bool canEatAll(vector<int>& piles, int h, int k) {
        long long totalHours = 0; // Overflow se bachne ke liye long long
        for (int pile : piles) {
            totalHours += (pile + k - 1) / k; // ceil(pile / k)
        }
        return totalHours <= h;
    }

    int minEatingSpeed(vector<int>& piles, int h) {
        int low = 1;
        int high = *max_element(piles.begin(), piles.end());
        int ans = high;

        while (low <= high) {
            int mid = low + (high - low) / 2;

            if (canEatAll(piles, h, mid)) {
                ans = mid;         // Mid valid speed hai, store kar lo
                high = mid - 1;    // Aur choti speed try karo (left shift)
            } else {
                low = mid + 1;     // Speed bohot kam hai, badhao (right shift)
            }
        }
        return ans;
    }
};
